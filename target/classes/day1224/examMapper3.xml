<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="day1224">

<!-- 컬럼 하나에 한 행 조회 
	String dname=ss.selectOne("scsr",부서번호) 
	부서번호를 입력받아서(parametertype)int 부서명(resulttype)string을 검색 -->
	<select id="scsr" parameterType="int" resultType="String">
	select dname
	from dept
	where deptno=#{deptno}
	</select>
	
	
<!-- 컬럼 하나에 여러행 조회
	부서번호를 입력받아서(paramaterType)int 
	부서에 속한 모든 사원명(resultType)String을 검색
	List<String>list=ss.selectList("아이디",부서번호)-->
<select id="scmr" parameterType="int" resultType="String">
	select ename
	from emp
	where deptno=#{deptno}
	</select>

<!-- 컬럼 여러개에 한 행 조회 
dto사용>typeAlias를 사용
사원번호를 입력받아서 사원명, 직무, 연봉, 입사일,매니저번호,부서번호 검색
-->
<select id="mcsr" parameterType="int" resultType="day1224.EmpDTO">
select ename,job,sal,hiredate,mgr,deptno,
	to_char(hiredate,'yyyy-mm-dd hh24') as strHiredate
from emp 
where empno=#{empno}
</select>


<!-- 컬럼 여러개 여러행 조회
조회컬럼과 메소드를 개발자가 수동으로 연결resultMap-->
<resultMap type="eDTO" id="eDtoResult">
<result column="empno" property="empno"/>
<result column="ename" property="ename"/>
<result column="job" property="job"/>
<result column="sal" property="sal"/>
<result column="hiredate" property="hiredate"/>
<result column="mgr" property="mgr"/>
<result column="deptno" property="deptno"/>
<result column="strHiredate" property="strHiredate"/>
</resultMap>
<select id="mcmr" parameterType="int" resultMap="eDtoResult">
select empno,ename,job,sal,hiredate,mgr,deptno,
	to_char(hiredate,'yyyy-mm-dd hh24') as strHiredate
from emp 
where deptno=#{deptno}
</select>


